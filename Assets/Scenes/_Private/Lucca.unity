  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Tutorial.Handlers.FirstCombatTutorial
  _tutorialKey: FirstCombatTutorial
  _titleString: Apresentacao
  _descriptionString: "Essa \xE9 a sua primeira apresenta\xE7\xE3o, diferentes pessoas
    da plateia est\xE3o sendo afetadas por Esp\xEDritos Obsessores que buscam se
    alimentar a felicidade dos outros.\nSeu Objetivo \xE9 impedir que o show acabe,
    protegendo o maximo que puder o Apresentador que est\xE1 no centro do Palco.\nPosicione
    os personagens para o show come\xE7ar."
