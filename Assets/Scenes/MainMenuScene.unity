  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Placeholders Circo Interior (Combate).\nPlaceholders Circo Interior (Gerenciamento).\nBlocagem
    do Mapa-M\xFAndi e Circo.\n\nEstudo de Materiais, explorando diferentes formas
    de aplicar o Cell Shading ou tecnicas parecidas em diferentes jogos e como seria
    o melhor caminho para se encaixar no nosso projeto.\n\nSistema de Cria\xE7\xE3o
    de a\xE7\xF5es, um facilitador para a cria\xE7\xE3o de a\xE7\xF5es de forma mais
    facil e rapida.\n\nSistema de Desafios, detec\xE7\xE3o de acontecimentos durante
    o combate para completar desafios determinados anteriormente.\n\nSistema de Input
    customizado, criada uma forma mais pratica de interagir com o New Input System
    da Unity, mantendo sua otimiza\xE7\xE3o e facilitando a acesso a informa\xE7\xF5es
    de input e detec\xE7\xE3o de colisores atrav\xE9s do Mouse.\n\nSistema de A\xFAdio
    que possui integra\xE7\xE3o com o FMOD.\n\nSistema de acelera\xE7\xE3o de a\xE7\xF5es,
    mantendo a velocidade de reprodu\xE7\xE3o do jogo a mesma, as anima\xE7\xF5es
    e a\xE7\xF5es s\xE3o aceleradas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
