  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: efd063da782bf76d3acc955a54622182, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 86567399424
    m_Localized: What a spectacular performance! That's what our world needs!
    m_Metadata:
      m_Items: []
  - m_Id: 4912738762440704
    m_Localized: It's not easy to confront bad feelings. I assure you, we would not
      be half the spectacle without you there.
    m_Metadata:
      m_Items: []
  - m_Id: 4912775127056384
    m_Localized: Thanks... I really needed to hear this. I just need some happy time
      to recoup.
    m_Metadata:
      m_Items: []
  - m_Id: 20177731002081280
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 20179539049095168
    m_Localized: You're the boss!
    m_Metadata:
      m_Items: []
  - m_Id: 20179804246548480
    m_Localized: We made so many smiles today!
    m_Metadata:
      m_Items: []
  - m_Id: 20185566322663424
    m_Localized: '[i]Upon seeing your approach, the walking car tries to accelerate
      his engine, but fails to achieve the usually energetic tone.[/i]'
    m_Metadata:
      m_Items: []
  - m_Id: 20186707622141952
    m_Localized: '[i]BEEP BEEP![/i]'
    m_Metadata:
      m_Items: []
  - m_Id: 20186824504811520
    m_Localized: '[i]As they would prepare to go up a big hill, it''s possible to
      hear the sound of a confident change of gears, followed by two pesses on the
      gas, ready to put their self-esteem in movement once again.[/i]'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
