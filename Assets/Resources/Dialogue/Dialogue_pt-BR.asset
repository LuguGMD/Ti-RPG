  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogue_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: efd063da782bf76d3acc955a54622182, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 86567399424
    m_Localized: "Que performance espetacular! \xC9 disso que nosso mundo precisa!"
    m_Metadata:
      m_Items: []
  - m_Id: 4912738762440704
    m_Localized: "Sentimentos negativos n\xE3o s\xE3o f\xE1ceis de confrontar. Pode
      apostar, n\xE3o ser\xEDamos metade daquele espet\xE1culo sem voc\xEA."
    m_Metadata:
      m_Items: []
  - m_Id: 4912775127056384
    m_Localized: "Obrigado... Eu precisava escutar isso. S\xF3 preciso de um tempo
      me divertindo pra me recuperar."
    m_Metadata:
      m_Items: []
  - m_Id: 20177731002081280
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 20179539049095168
    m_Localized: "Voc\xEA quem manda!"
    m_Metadata:
      m_Items: []
  - m_Id: 20179804246548480
    m_Localized: Conseguimos tantos sorrisos hoje!
    m_Metadata:
      m_Items: []
  - m_Id: 20185566322663424
    m_Localized: "[i]Ao ver que se aproxima, o carro ambulante tenta acelerar seu
      motor, mas falha em atingir o tom energ\xE9tico usual.[/i]"
    m_Metadata:
      m_Items: []
  - m_Id: 20186824504811520
    m_Localized: "[i]Como se preparasse para enfrentar uma grande subida, \xE9 poss\xEDvel
      escutar uma confiante troca de marchas seguida de duas aceleradas, prontas
      para por sua auto estima em movimento mais uma vez.[/i]"
    m_Metadata:
      m_Items: []
  - m_Id: 20186707622141952
    m_Localized: '[i]BI BI![/i]'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
